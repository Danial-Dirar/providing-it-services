# Copy to .env for local development
PORT=3100
NODE_ENV=development
SITE_URL=http://localhost:3100

# Where contact enquiries are written (JSONL). Swap for SMTP/CRM later.
# Ignored on Vercel — the filesystem is read-only there, so enquiries go to the
# function log instead. See handout.md §5.1.
ENQUIRY_LOG_DIR=./data/enquiries

# Optional SMTP (not wired yet — see handout.md)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ENQUIRY_TO=info@providingitservices.com

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
# Set only SITE_URL, and only for the Production environment:
#   vercel env add SITE_URL production   ->   https://providingitservices.com
#
# Do NOT set it for Preview. Preview deployments fall back to VERCEL_URL so
# their canonical tags point at themselves rather than at the live site.
#
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_URL and VERCEL_GIT_COMMIT_SHA are all
# provided by the platform — never set them by hand.
