<section class="section cta on-dark">
  <div class="mesh-bg" aria-hidden="true"></div>
  <div class="shell shell--wide cta__inner">
    <div data-reveal>
      <p class="label">Next step</p>
      <h2 class="cta__title mt-1">Tell us what you are trying to fix</h2>
      <p class="lede mb-3">Send the problem, not a specification. We will tell you whether it is a project, a team, an audit, or nothing at all — and we will say which one before we quote.</p>
      <div class="cta__actions">
        <a class="btn btn--lg" href="/contact"><span class="btn__label">Start a conversation</span></a>
        <a class="btn btn--lg btn--ghost" href="/services"><span class="btn__label">See the practices</span></a>
      </div>
    </div>

    <div class="cta__facts" data-reveal style="--i: 1">
      <div class="cta__fact">
        <span class="label">Reply time</span>
        <p>One working day, from a person who read it.</p>
      </div>
      <div class="cta__fact">
        <span class="label">Email</span>
        <p><a href="mailto:{{company.email}}">{{company.email}}</a></p>
      </div>
      <div class="cta__fact">
        <span class="label">Phone</span>
        <p><a href="tel:{{company.phoneHref}}">{{company.phone}}</a></p>
      </div>
      <div class="cta__fact">
        <span class="label">Office</span>
        <p>{{company.address.line1}}, {{company.address.line2}}</p>
      </div>
    </div>
  </div>
</section>
