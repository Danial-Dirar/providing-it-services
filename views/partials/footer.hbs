<footer class="footer">
  <div class="shell shell--wide">
    <div class="footer__top">
      <div class="footer__col">
        <a class="brand" href="/" aria-label="{{company.name}} — home">
          <span class="brand__mark"><img src="/assets/img/mark.svg" alt="" width="38" height="38"></span>
          <span class="brand__text">
            <span class="brand__name">Providing&nbsp;IT&nbsp;Services</span>
            <span class="brand__sub">Technology · Consulting · Support</span>
          </span>
        </a>
        <p class="footer__blurb">Software, data and operations teams built in New York for companies here and abroad.</p>
        <address class="footer__address">
          {{company.address.line1}}<br>
          {{company.address.line2}}<br>
          {{company.address.country}}
        </address>
      </div>

      <div class="footer__col">
        <h4>Services</h4>
        <ul>
          {{#each navServices}}
            <li><a href="/services/{{this.slug}}">{{this.title}}</a></li>
          {{/each}}
        </ul>
      </div>

      <div class="footer__col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Get in touch</h4>
        <ul>
          <li><a href="mailto:{{company.email}}">{{company.email}}</a></li>
          <li><a href="tel:{{company.phoneHref}}">{{company.phone}}</a></li>
        </ul>
        <h4 class="mt-2">Follow</h4>
        <ul>
          {{#each company.social}}
            <li><a href="{{this.href}}" rel="noopener noreferrer" target="_blank">{{this.name}}</a></li>
          {{/each}}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{year}} {{company.legalName}}. All rights reserved.</p>
      <p>Brooklyn, NY · {{company.hours}}</p>
      <nav class="footer__legal" aria-label="Legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </div>

    <div class="footer__credit">
      <span class="footer__credit-label">Built by</span>
      <p class="footer__credit-line">
        Developed and maintained by
        <a
          class="footer__credit-link"
          href="https://haifa-ai.com"
          rel="noopener noreferrer"
          target="_blank"
        >Haifa Intelligence</a>
      </p>
    </div>

    <p class="footer__wordmark" aria-hidden="true">Providing IT Services</p>
  </div>
</footer>
