<section class="page-hero">
  <div class="mesh-bg" aria-hidden="true"></div>
  <div class="shell shell--wide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Services</span>
    </nav>
    <h1 class="page-hero__title" data-reveal>{{hero.title}}</h1>
    <p class="lede" data-reveal style="--i: 1">{{hero.lede}}</p>
  </div>
</section>

<section class="section section--tight on-light">
  <div class="shell shell--wide">
    <div class="matrix">
      {{#each services}}
        <article class="practice" data-reveal style="--i: {{@index}}">
          <div class="practice__head">
            <span class="practice__code">{{this.code}}</span>
            <span class="practice__arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 12L12 4M12 4H5.5M12 4v6.5"/>
              </svg>
            </span>
          </div>
          <h2 class="practice__title">{{this.title}}</h2>
          <p class="practice__tagline">{{this.tagline}}</p>
          <ul class="practice__list">
            {{#each (take this.deliverables 3)}}<li>{{this}}</li>{{/each}}
          </ul>
          <a class="practice__link" href="/services/{{this.slug}}"><span>{{this.title}}</span></a>
        </article>
      {{/each}}
    </div>
  </div>
</section>

<section class="section on-dark">
  <div class="shell shell--wide">
    <div class="rail">
      <div class="rail__aside" data-reveal>
        <span class="label">Engagement</span>
        <p class="muted" style="font-size: var(--step--1)">The same four stages regardless of which practice you start with.</p>
      </div>
      <div>
        <div class="section__head mb-3" data-reveal>
          <h2 class="t-xl">How an engagement actually runs</h2>
          <p class="lede">Every stage ends in something you can open and read for yourself — a document, an environment, a report.</p>
        </div>
        <div class="process">
          {{#each process}}
            <div class="step" data-reveal style="--i: {{@index}}">
              <span class="step__num">{{this.step}}</span>
              <h3 class="step__name">{{this.name}}</h3>
              <p class="step__duration">{{this.duration}}</p>
              <p class="step__body">{{this.body}}</p>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</section>

{{> cta}}
