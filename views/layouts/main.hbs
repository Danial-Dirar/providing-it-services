<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta.title}}</title>
  <meta name="description" content="{{meta.description}}">
  <link rel="canonical" href="{{canonical}}">
  {{#if meta.noindex}}<meta name="robots" content="noindex, follow">{{/if}}

  <meta name="theme-color" content="#04162a">
  <meta name="author" content="{{company.name}}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{company.name}}">
  <meta property="og:title" content="{{meta.title}}">
  <meta property="og:description" content="{{meta.description}}">
  <meta property="og:url" content="{{canonical}}">
  <meta property="og:image" content="{{siteUrl}}/assets/img/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Providing IT Services — technology, consulting and support, Dhaka">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{meta.title}}">
  <meta name="twitter:description" content="{{meta.description}}">
  <meta name="twitter:image" content="{{siteUrl}}/assets/img/og.jpg">

  <link rel="icon" href="/assets/img/mark.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">

  {{!-- Fonts are self-hosted; these two carry the hero, so preload them. --}}
  <link rel="preload" href="/assets/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css?v={{buildId}}">
  <link rel="stylesheet" href="/assets/css/site.css?v={{buildId}}">

  {{!-- Runs before paint so the reveal states only apply when JS is alive. --}}
  <script src="/assets/js/boot.js?v={{buildId}}"></script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{company.name}}",
    "description": "{{company.description}}",
    "url": "{{siteUrl}}",
    "logo": "{{siteUrl}}/assets/img/mark.svg",
    "image": "{{siteUrl}}/assets/img/og.jpg",
    "email": "{{company.email}}",
    "telephone": "{{company.phone}}",
    "foundingDate": "{{company.founded}}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{company.address.line1}}",
      "addressLocality": "Dhaka",
      "postalCode": "1213",
      "addressCountry": "BD"
    },
    "areaServed": ["Bangladesh", "United Kingdom", "United States", "Australia", "Singapore", "United Arab Emirates"],
    "knowsAbout": ["Web Development", "Data Analytics", "IT Enabled Services", "IT Consultancy", "Business Process Outsourcing", "Business Development"]
  }
  </script>
</head>
<body data-page="{{page}}">
  <a class="skip-link" href="#main">Skip to content</a>

  {{> header}}

  <main id="main">
    {{{body}}}
  </main>

  {{> footer}}

  <script type="module" src="/assets/js/main.js?v={{buildId}}"></script>
</body>
</html>
